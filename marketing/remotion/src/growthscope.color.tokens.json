{
  "$schema": "https://tr.designtokens.org/format/",
  "color": {
    "$type": "color",
    "brand": {
      "yellow": {
        "$value": "#FDE047",
        "$description": "Primary accent. Logo, links, and highlighted type. Pairs with blue/green/pink highlight blocks."
      },
      "blue": {
        "$value": "#2563EB",
        "$description": "Highlight block background."
      },
      "green": {
        "$value": "#16A34A",
        "$description": "Highlight block background."
      },
      "pink": {
        "$value": "#EC4899",
        "$description": "Highlight block background."
      }
    },
    "base": {
      "background": {
        "$value": "#171717",
        "$description": "Default page background (neutral-900)."
      },
      "foreground": {
        "$value": "#FFFFFF",
        "$description": "Default text color on the base background."
      }
    },
    "neutral": {
      "$description": "Tailwind neutral scale used for surfaces and muted text.",
      "50": { "$value": "#FAFAFA" },
      "100": { "$value": "#F5F5F5" },
      "200": { "$value": "#E5E5E5" },
      "300": { "$value": "#D4D4D4" },
      "400": { "$value": "#A3A3A3" },
      "500": { "$value": "#737373" },
      "600": { "$value": "#525252" },
      "700": { "$value": "#404040" },
      "800": { "$value": "#262626" },
      "900": { "$value": "#171717" },
      "950": { "$value": "#0A0A0A" }
    }
  }
}
